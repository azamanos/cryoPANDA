    <imageSet>
        <name>Equalized particle stack of Influenza Hemagglutinin Trimer from 40 degree tilted micrographs</name>
        <directory>/data/Particle-Stack</directory>
        <category>picked particles - multiframe - processed</category>
        <headerFormat>MRC</headerFormat>
        <dataFormat>MRC</dataFormat>
        <numImagesOrTiltSeries>130000</numImagesOrTiltSeries>
        <framesPerImage>1</framesPerImage>
        <voxelType>32 BIT FLOAT</voxelType>
        <dimensions>
            <imageWidth>256</imageWidth>
            <pixelWidth>1.31</pixelWidth>
            <imageHeight>256</imageHeight>
            <pixelHeight>1.31</pixelHeight>
        </dimensions>
        <details>Equalized particle stack of Influenza Hemagglutinin Trimer from 40 degree tilted micrographs. Particles were extracted from aligned, exposured weighted and summed micrographs. In order to compare these particles with a 40 degree tilted dataset, these particles were equalized based on GCTF-estimated per-particle CTF values so a subset of particles with the same defocus spread would be obtained. This equalized stack of 130,000 is the uploaded stack. A Relion .star metadata file is also provided containing the final refined Euler angles.</details>
        <segmentationList/>
        <micrographsFilePattern></micrographsFilePattern>
        <pickedParticlesFilePattern></pickedParticlesFilePattern>
        <pickedParticlesDirectory></pickedParticlesDirectory>
