    <imageSet>
        <name>PI3-kinase SH3 amyloid fibrils, MotionCor2-aligned dose-weighted averages</name>
        <directory>/data/SH3/Micrographs</directory>
        <category>micrographs - single frame</category>
        <headerFormat>MRC</headerFormat>
        <dataFormat>MRC</dataFormat>
        <numImagesOrTiltSeries>256</numImagesOrTiltSeries>
