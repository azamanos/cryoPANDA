        <micrographsFilePattern>data/22feb15b-Glacios_Falcon3_integrating/*to*/*enn-a-DW.mrc</micrographsFilePattern>
        <pickedParticlesFilePattern></pickedParticlesFilePattern>
        <pickedParticlesDirectory></pickedParticlesDirectory>
    </imageSet>
